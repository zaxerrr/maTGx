# ── Required ────────────────────────────────────────────────────────
# Telegram bot token (from @BotFather). Everything else — MAX login, groups,
# several MAX accounts — is configured in the bot's private chat: send /start.
TG_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# ── Optional ────────────────────────────────────────────────────────
# Bridge owner (your Telegram user id, @userinfobot). If unset, the first user
# who sends /start to the bot becomes the owner. Only the owner can configure
# the bridge and write to MAX through it.
# TG_ALLOWED_USER_ID=123456789

# Legacy single-account setup (still supported): creates account "main".
# MAX_TOKEN / MAX_DEVICE_ID = __oneme_auth / __oneme_device_id from web.max.ru
# Local Storage; TG_CHAT_ID = forum supergroup id (-100…).
# MAX_TOKEN=
# MAX_DEVICE_ID=
# TG_CHAT_ID=-1001234567890
# MAX_CHAT_IDS=-123,-456

# SOCKS5 proxy for Telegram (e.g. socks5://user:pass@host:port)
# TG_PROXY=socks5://127.0.0.1:1080

# HTTP(S) proxy for MAX (WebSocket + media), e.g. a Russian exit node if MAX
# limits your server's IP: http://user:pass@host:port
# MAX_PROXY=http://127.0.0.1:3128

# Directory for persistent state (accounts, topics, message map). Default: state
# STATE_DIR=state

# Run blocking calls on the event loop instead of threads — only for VPSes
# where the OS refuses to create threads.
# SYNC_EXECUTOR=false

# Verbose logs + JSON dump to debug/ (tokens are masked)
DEBUG=false

# Telegram → MAX sending (default: true)
# REPLY_ENABLED=true
